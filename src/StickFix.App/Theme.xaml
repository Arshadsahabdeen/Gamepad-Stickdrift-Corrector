<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0F1218" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#141821" />
    <SolidColorBrush x:Key="CardBrush" Color="#1A1F2B" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A3140" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#222836" />
    <SolidColorBrush x:Key="TextBrush" Color="#EEF1F6" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A3ADBD" />
    <SolidColorBrush x:Key="AccentBrush" Color="#22D3EE" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#67E8F9" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#06222A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FCA5A5" />
    <SolidColorBrush x:Key="GoodBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="OnGoodBrush" Color="#052E16" />

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style x:Key="Warning" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{StaticResource TextBrush}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource CardBorderBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A left-hand sidebar. It stays a TabControl so keyboard navigation and screen readers work without extra code. -->
    <Style x:Key="SidebarTabs" TargetType="TabControl">
        <!-- Every page inherits this. Without it, controls that don't set their own colour fall back to black. -->
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
                            <DockPanel Margin="10,16">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,20">
                                    <Image Source="Assets/StickFix.ico" Width="30" Height="30" AutomationProperties.Name="StickFix logo" />
                                    <TextBlock Text="StickFix" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Margin="8,0" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <TabPanel IsItemsHost="True" Background="Transparent" />
                            </DockPanel>
                        </Border>
                        <!-- WPF finds this by name to expose page content to screen readers and UI automation. -->
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Box" Background="Transparent" CornerRadius="6" Margin="0,0,0,4" Padding="0,9,8,9">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Bar" Width="3" Height="18" CornerRadius="2" Background="Transparent" Margin="2,0,10,0" />
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource NavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource NavHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource NavHoverBrush}" />
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
